{
  "name": "safeflash",
  "version": "0.1.0",
  "private": true,
  "description": "The safety gate for AI-generated firmware.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @safeflash/web",
    "dev:competition": "npm run dev --workspace @safeflash/web -- --port 3018",
    "build": "npm run build --workspace @safeflash/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:adversarial": "vitest run tests/adversarial",
    "test:secrets": "vitest run tests/adversarial/secrets.test.ts --reporter=default",
    "test:firmware": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-firmware.ps1",
    "test:e2e": "playwright test",
    "demo:local": "tsx scripts/run-local-tournament.ts",
    "demo:cross-device": "tsx scripts/run-cross-device-proof.ts",
    "demo:live": "tsx scripts/run-live-workflow.ts",
    "smoke:external": "tsx scripts/smoke-external.ts",
    "day-of:check": "tsx scripts/day-of-check.ts",
    "prepare:demo-pr": "tsx scripts/prepare-demo-pr.ts",
    "rehearsal": "tsx scripts/rehearsal.ts",
    "evidence:verify": "tsx scripts/verify-evidence.ts",
    "verify:phase8": "tsx scripts/capture-phase8-evidence.ts",
    "verify:p0": "tsx scripts/capture-p0-evidence.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@copilotkit/react-core": "1.63.1",
    "@daytona/sdk": "0.200.1",
    "braintrust": "3.24.0",
    "next": "16.2.11",
    "octokit": "5.0.5",
    "openai": "6.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "overrides": {
    "@opentelemetry/propagator-jaeger": "2.10.0",
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
