FROM node:22.18.0-bookworm-slim AS safecommit_dependencies

WORKDIR /workspace

RUN npm init --yes \
    && npm install --no-save --no-audit --no-fund \
      mysql2@3.23.1 \
      node-sql-parser@5.4.0 \
      tsx@4.23.1 \
      zod@4.4.3

FROM mysql:8.0.36

COPY --from=safecommit_dependencies /usr/local/bin/node /usr/local/bin/node
COPY --from=safecommit_dependencies /workspace/node_modules /workspace/node_modules
COPY schema/001_schema.sql /docker-entrypoint-initdb.d/001_schema.sql
COPY seed/002_seed.sql /docker-entrypoint-initdb.d/002_seed.sql

ENV MYSQL_ALLOW_EMPTY_PASSWORD=yes
ENV MYSQL_DATABASE=safecommit

WORKDIR /workspace

HEALTHCHECK --interval=2s --timeout=2s --start-period=15s --retries=30 \
  CMD mysqladmin ping --protocol=tcp --host=127.0.0.1 --user=root --silent

CMD ["mysqld", "--bind-address=127.0.0.1", "--character-set-server=utf8mb4", "--collation-server=utf8mb4_0900_ai_ci", "--default-authentication-plugin=mysql_native_password", "--transaction-isolation=READ-COMMITTED"]
