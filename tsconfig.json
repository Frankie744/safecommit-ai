{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@safeflash/domain": ["./packages/domain/src/index.ts"],
      "@safeflash/safety-policy": ["./packages/safety-policy/src/index.ts"],
      "@safeflash/integrations": ["./packages/integrations/src/index.ts"],
      "@safeflash/evals": ["./packages/evals/src/index.ts"],
      "@safeflash/orchestrator": ["./apps/orchestrator/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".next", "fixtures/**/build"]
}
