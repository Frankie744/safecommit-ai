# SafeFlash never silently falls back from live providers. Valid values are
# live, cached, and mock. Mock results are always labelled in the UI.
SAFEFLASH_DEFAULT_MODE=mock

# SafeCommit database profile. Every mutation is server-only, same-origin, and
# requires this operator capability. Generate a random value; never use a
# NEXT_PUBLIC_ prefix or commit a populated value.
SAFECOMMIT_OPERATOR_TOKEN=
SAFECOMMIT_APPROVER_ID=demo-operator
SAFECOMMIT_SOURCE_COMMIT_SHA=
# Local OpenBoxes-derived MySQL fixture only. Production credentials must use
# a separate secret manager and a least-privilege database role.
SAFECOMMIT_MYSQL_URL=
SAFECOMMIT_DATABASE_EVIDENCE_DIR=artifacts/evidence/safecommit-database-local
# Cached mode is read-only and requires a complete immutable artifact generated
# from one real five-provider Live run. Empty means NOT_AVAILABLE.
SAFEFLASH_RECORDED_LIVE_PATH=
# Server-only HMAC attestation key for capture and replay (minimum 32
# characters). Keep it outside source, logs, screenshots, and evidence.
SAFEFLASH_RECORDED_LIVE_SIGNING_KEY=
# This is the shared authorization gate for real provider calls. The bounded
# `npm run smoke:external` command performs: one Fireworks inference; one
# private ephemeral Daytona sandbox create/delete; Braintrust smoke Dataset,
# Trace, and Experiment writes; and read-only GitHub/CodeRabbit checks. It
# never creates, updates, or merges a GitHub PR.
SAFEFLASH_ALLOW_LIVE=false
SAFEFLASH_SESSION_DIR=.safeflash/sessions
SAFEFLASH_EVIDENCE_DIR=artifacts/evidence
SAFEFLASH_RETAIN_SANDBOXES=false
# Audit label only; this is not authentication. Keep the demo access-controlled.
SAFEFLASH_APPROVER_ID=demo-operator
SAFEFLASH_WORKSPACE_ROOT=
SAFEFLASH_REHEARSAL_PORT=3018
SAFEFLASH_CERTIFIED_MAIN_SHA=6402e26db834069946aaab4391e8ef2dd224ad5e
SAFEFLASH_CERTIFIED_PR_NUMBER=1
SAFEFLASH_CERTIFIED_PR_HEAD_SHA=5b418b7eeac67e433609d0a0ca5ab6309bd4fe32

# Competition-day reservation only. The composer conversion core is not
# implemented in Phase 8 and this feature remains disabled by default.
SAFEFLASH_ENABLE_POLICY_COMPOSER=false

# Server-only one-time capability required before GitHub PR create/update.
# Generate 32 random bytes as canonical base64url, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never expose this value through NEXT_PUBLIC_ or persist it in evidence.
SAFEFLASH_PUBLISH_AUTH_SECRET=
SAFEFLASH_PUBLISH_AUTH_TTL_MS=120000
SAFEFLASH_PUBLISH_AUTH_REPLAY_DIR=.safeflash/publish-authorization-replay

# Fireworks AI: https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=

# Daytona: create a key in the Daytona dashboard. Leave DAYTONA_API_URL empty
# to use the official SDK default.
DAYTONA_API_KEY=
# SafeFlash accepts only https://app.daytona.io/api to prevent key exfiltration.
DAYTONA_API_URL=
DAYTONA_TARGET=

# Braintrust: https://www.braintrust.dev/app/settings?subroute=api-keys
# The external smoke writes test-labelled evidence to these names.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_NAME=SafeFlash
BRAINTRUST_DATASET_NAME=Firmware Safety Incidents

# GitHub fine-grained token: Contents and Pull requests read/write on the
# public demo repository. SafeFlash creates/updates PRs but never merges them.
GITHUB_TOKEN=
GITHUB_OWNER=Frankie744
GITHUB_REPO=safeflash-ai
GITHUB_BASE_BRANCH=main
GITHUB_EXPECT_PUBLIC=true
# The REST API version is security-pinned in packages/integrations/src/github.ts.

# CodeRabbit is installed as a GitHub App. Review data is read through GitHub.
CODERABBIT_REVIEW_TIMEOUT_MS=180000
CODERABBIT_POLL_INTERVAL_MS=5000

# A real existing, open, unmerged PR is required for the read-only CodeRabbit
# smoke check. The SHA must be the exact current PR head, not a branch name.
SAFEFLASH_SMOKE_PR_NUMBER=
SAFEFLASH_SMOKE_PR_HEAD_SHA=

# Optional CopilotKit Cloud public key. No provider secret may use NEXT_PUBLIC_.
NEXT_PUBLIC_COPILOT_CLOUD_PUBLIC_API_KEY=
